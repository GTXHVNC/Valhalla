[Unit]
Description=Valhalla Relay onion/WebSocket connection server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valhalla
Group=valhalla
ExecStart=/opt/valhalla/bin/valhalla-relay --panel-listen 0.0.0.0:443
Restart=on-failure
RestartSec=5s
RuntimeDirectory=valhalla
RuntimeDirectoryMode=0750
StateDirectory=valhalla
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/valhalla /run/valhalla
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=20000
TasksMax=8192

[Install]
WantedBy=multi-user.target
