[Unit]
Description=Valhalla telemetry application
Requires=valhalla-relay.service
After=valhalla-relay.service

[Service]
Type=simple
User=valhalla
Group=valhalla
Environment=VALHALLA_IPC_SOCKET=/run/valhalla/telemetry.sock
ExecStart=/usr/bin/python3 /opt/valhalla/telemetry_service.py
Restart=always
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/valhalla

[Install]
WantedBy=multi-user.target
